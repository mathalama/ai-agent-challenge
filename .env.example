# Скопируйте файл в .env в корне проекта и заполните ключи.
# Провайдер, модель и адрес API удобнее выбрать командой rs config или в окне «Настройки» веб-чата.
# Переменные окружения и .env имеют приоритет над этими настройками, поэтому заполняйте
# раздел «Переопределения» только для Docker или разовых прогонов.
# Пустое значение означает настройку по умолчанию. Комментарии пишите отдельной строкой:
# docker compose и dotenv по-разному разбирают комментарий в конце строки.
# Для --provider mock ничего заполнять не нужно.

# ---------------------------------------------------------------------------
# Общие настройки
# ---------------------------------------------------------------------------

# Темп запросов к LLM в минуту, по умолчанию 5. Действует для Gemini и OpenAI-совместимых API.
# Сверьте с активной квотой проекта и модели: https://aistudio.google.com/rate-limit
LLM_REQUESTS_PER_MINUTE=5

# Уровень логов в stderr: error, warn, info, debug, trace. По умолчанию warn.
# Можно задать по модулям, например warn,llm=debug.
RUST_LOG=warn

# ---------------------------------------------------------------------------
# Ключи
# ---------------------------------------------------------------------------

# Ключ Gemini из Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ключ OpenRouter: https://openrouter.ai/settings/keys
# Используется, когда в настройках выбран адрес https://openrouter.ai/api/v1.
OPENROUTER_API_KEY=

# Ключи Groq, DeepSeek и других сервисов вводите в rs config: там ключ хранится вместе с адресом API.

# ---------------------------------------------------------------------------
# Провайдер по умолчанию
# ---------------------------------------------------------------------------

# Провайдер CLI: mock, gemini или openai. Пустое значение берёт провайдер из rs config,
# без сохранённых настроек используется gemini. Флаг --provider важнее этой переменной.
RS_PROVIDER=

# ---------------------------------------------------------------------------
# Переопределения. Оставьте пустыми, если настраиваете провайдера через rs config
# ---------------------------------------------------------------------------

# Модель Gemini, по умолчанию gemini-3.1-flash-lite. Префикс models/ можно не писать.
# Каталог моделей: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Адрес API Gemini без /models.
GEMINI_BASE_URL=

# API, совместимый с OpenAI (--provider openai): OpenAI, OpenRouter, Groq, DeepSeek, Ollama.
# Ключ действует только с адресом из OPENAI_BASE_URL или с https://api.openai.com/v1,
# если адрес не задан. Задавайте ключ и адрес вместе.
# Для Ollama подойдёт любое непустое значение ключа.
OPENAI_API_KEY=

# Адрес API без /chat/completions, по умолчанию https://api.openai.com/v1.
# OpenRouter: https://openrouter.ai/api/v1
# Groq:       https://api.groq.com/openai/v1
# DeepSeek:   https://api.deepseek.com/v1
# Ollama:     http://localhost:11434/v1
OPENAI_BASE_URL=

# Имя модели в каталоге сервиса, без пробелов, например gpt-4.1-mini, deepseek-chat, qwen3:14b.
OPENAI_MODEL=

# Формат ответа: json_schema (по умолчанию), json_object или none.
# Для DeepSeek, Groq и Ollama используйте json_object.
OPENAI_RESPONSE_FORMAT=

# ---------------------------------------------------------------------------
# Тонкая настройка OpenAI-совместимых API. Задаётся только здесь
# ---------------------------------------------------------------------------

# reasoning_effort для рассуждающих моделей: none, low, medium, high.
# Для qwen3 в Ollama ставьте none, иначе модель долго рассуждает и тратит токены.
OPENAI_REASONING_EFFORT=

# Таймаут одного запроса в секундах, от 1 до 3600, по умолчанию 180.
# Для локальных моделей увеличьте до 600–900.
OPENAI_TIMEOUT_SECS=

# Положительный лимит токенов ответа, передаётся как max_tokens.
# Пустое значение оставляет настройку сервиса.
OPENAI_MAX_TOKENS=

# ---------------------------------------------------------------------------
# Docker Compose (docker compose up)
# ---------------------------------------------------------------------------

# Провайдер сервера в контейнере: mock, gemini или openai. По умолчанию mock.
# Окно настроек в контейнере недоступно: для openai заполните раздел «Переопределения».
PROVIDER=

# Порт на localhost для веб-чата, по умолчанию 3333.
PORT=

# Версия в паспорте отчёта при сборке образа, по умолчанию версия пакета.
# Например, короткий хеш коммита из git rev-parse --short HEAD.
AGENT_VERSION=
