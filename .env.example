GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Укажите значение в пределах активной квоты проекта и модели в Google AI Studio.
LLM_REQUESTS_PER_MINUTE=5
RUST_LOG=warn
# Для --provider openai (любой API, совместимый с OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# json_schema или json_object (для сервисов без строгой схемы, например DeepSeek)
OPENAI_RESPONSE_FORMAT=json_schema
# Необязательно: low, none и т. п. для рассуждающих моделей
OPENAI_REASONING_EFFORT=
